// cSpell Settings
{
    "version": "0.2",
    "language": "en",
    "ignorePaths": [
        "bootstrap/cache/**",
        "build/**",
        "compose.yaml",
        "composer.json",
        "composer.lock",
        "cov.xml",
        "deploy/**",
        "docs/**",
        "node_modules/**",
        "package.json",
        "package-lock.json",
        "phpstan.neon",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "public/build/**",
        "public/css/app.css",
        "public/js/app.js",
        "resources/js/actions/**",
        "scripts/**",
        "storage/debugbar/**",
        "storage/framework/**",
        "storage/inertia-devtools/**",
        "storage/logs/**",
        "vendor/**",
        "vite.config.ts"
    ],
    "allowCompoundWords": true,
    "dictionaries": ["php", "custom-words"],
    // Tell CSpell about your dictionary
    "dictionaryDefinitions": [
        {
            "name": "custom-words",
            "path": "./.cSpell.words.txt",
            "addWords": true
        }
    ]
}
