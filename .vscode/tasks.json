{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "spellcheck",
            "type": "shell",
            "command": "cspell lint '**'"
        },
        {
            "label": "HTML/CSS format check",
            "type": "shell",
            "command": "npx prettier --check \"resources/views/**/*.blade.php\" \"resources/js/**/*.{js,jsx,ts,tsx}\"",
            "options": {
                "cwd": "${workspaceFolder}/book-keeping"
            }
        },
        {
            "label": "static analysis",
            "type": "shell",
            "command": "./vendor/bin/phpstan analyse",
            "options": {
                "cwd": "${workspaceFolder}/book-keeping",
                "env": {
                    "XDEBUG_MODE": "off"
                }
            }
        },
        {
            "label": "build asset",
            "type": "shell",
            "command": "npm run build",
            "options": {
                "cwd": "${workspaceFolder}/book-keeping"
            }
        },
        {
            "label": "unit test and coverage",
            "type": "shell",
            "command": "./vendor/bin/phpunit --coverage-clover ../build/logs/cov.xml",
            "options": {
                "cwd": "${workspaceFolder}/book-keeping",
                "env": {
                    "XDEBUG_MODE": "coverage"
                }
            },
            "dependsOn": "build asset"
        },
        {
            "label": "create release archive for xrea",
            "type": "shell",
            "command": "scripts/create-release-for-xrea.sh"
        },
        {
            "label": "set up dev environment",
            "type": "shell",
            "command": "scripts/setup-dev-environment.sh",
            "options": {
                "env": {
                    "XDEBUG_MODE": "off"
                }
            }
        }
    ]
}
